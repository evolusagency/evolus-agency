---
// src/components/Hero.astro
// Premium Hero section — GSAP enhanced
//
// NEW ADDITIONS vs previous version:
// ─────────────────────────────────────
// 1. GSAP CLICK RIPPLE
//    Each click spawns a geometric hex-ring burst that expands + fades via GSAP timeline.
//
// 2. HUD TECH OVERLAY
//    A transparent scanning-line / radar-corner UI layer — pure CSS + GSAP ambient motion.
//    Renders above the grid, below content (z-index layering preserved).
//
// 3. WORKS BUTTON
//    Magnetic blob hover: cursor proximity warps the button shape with CSS clip-path +
//    a glowing radial that tracks mouse position inside the button.
---

<section class="hero" id="home" aria-label="Hero — Evolus Agency">
  <!-- Layered backgrounds -->
  <div class="hero-bg"   aria-hidden="true"></div>
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-glow" aria-hidden="true"></div>

  <!-- ── HUD TECH OVERLAY (new) ──────────────────────────────── -->
  <div class="hud" aria-hidden="true">
    <!-- Corner brackets -->
    <div class="hud-corner hud-tl"></div>
    <div class="hud-corner hud-tr"></div>
    <div class="hud-corner hud-bl"></div>
    <div class="hud-corner hud-br"></div>

    <!-- Scan line -->
    <div class="hud-scan"></div>

    <!-- Floating data readouts -->
    <div class="hud-data hud-data--tl">
      <span class="hud-label">LAT</span><span class="hud-val" id="hud-lat">48.8566° N</span>
      <span class="hud-label">LNG</span><span class="hud-val" id="hud-lng">002.3522° E</span>
    </div>
    <div class="hud-data hud-data--br">
      <span class="hud-label">SYS</span><span class="hud-val">ONLINE</span>
      <span class="hud-label">VER</span><span class="hud-val">2.4.1</span>
    </div>

    <!-- Crosshair target (top-right area, decorative) -->
    <svg class="hud-reticle" viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="30" cy="30" r="20" stroke="currentColor" stroke-width="0.5" stroke-dasharray="4 6"/>
      <circle cx="30" cy="30" r="10" stroke="currentColor" stroke-width="0.5"/>
      <line x1="30" y1="4"  x2="30" y2="14" stroke="currentColor" stroke-width="0.75"/>
      <line x1="30" y1="46" x2="30" y2="56" stroke="currentColor" stroke-width="0.75"/>
      <line x1="4"  y1="30" x2="14" y2="30" stroke="currentColor" stroke-width="0.75"/>
      <line x1="46" y1="30" x2="56" y2="30" stroke="currentColor" stroke-width="0.75"/>
    </svg>

    <!-- Progress bar (horizontal) -->
    <div class="hud-bar-wrap">
      <div class="hud-bar-track">
        <div class="hud-bar-fill" id="hud-bar"></div>
      </div>
      <span class="hud-label hud-bar-label" id="hud-pct">72%</span>
    </div>
  </div>
  <!-- ─────────────────────────────────────────────────────────── -->

  <!-- Click ripple canvas (GSAP injects elements here) -->
  <div class="ripple-layer" id="rippleLayer" aria-hidden="true"></div>

  <div class="hero-inner">
    <!-- LEFT: main content -->
    <div class="hero-content">
      <div class="hero-tag" data-i18n="hero.tag" aria-label="Agency label">
        Evolus Agency
      </div>

      <h1 class="hero-title">
        <span class="ht-line ht-l1" id="hl1" data-i18n="hero.line1">On crée</span>
        <span class="ht-line ht-l2">
          <span data-i18n="hero.line2pre">votre\n</span> 
          <em class="ht-accent" data-i18n="hero.line2em">présence</em>
        </span>
        <span class="ht-line ht-l3 out" data-i18n="hero.line3">digitale.</span>
      </h1>

      <div class="hero-bot">
        <p class="hero-desc" data-i18n="hero.desc">
          Sites web sur-mesure, contenu qui convertit, et stratégies de croissance.
        </p>
        <div class="hero-acts">
          <a class="btn-p" href="#contact">
            <span data-i18n="hero.cta">Lancer mon projet</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M7 17L17 7M17 7H7M17 7v10"/>
            </svg>
          </a>

          <!-- ── WORKS BUTTON (new) ──────────────────────────── -->
          <a class="btn-works" href="/works" id="btnWorks" aria-label="Voir nos projets">
            <!-- Magnetic blob glow (JS injects inline style) -->
            <span class="btn-works__blob" id="worksBlob" aria-hidden="true"></span>
            <span class="btn-works__label">
              <span data-i18n="hero.works">Voir nos projets</span>
              <svg class="btn-works__arrow" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </span>
          </a>
          <!-- ──────────────────────────────────────────────────── -->

          <a class="btn-g" href="/blog">
            <span data-i18n="hero.blog">Voir le blog</span>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- RIGHT: stat counters -->
    <aside class="hero-stats" aria-label="Key statistics">
      <div class="cnt-i">
        <div class="cnt-n">
          <span class="count-up" data-target="120" aria-label="120 sites livrés">0</span>+
        </div>
        <div class="cnt-l" data-i18n="hero.stat1l">Sites livrés</div>
      </div>
      <div class="cnt-i">
        <div class="cnt-n">
          <span class="count-up" data-target="3" aria-label="ROI moyen 3x">0</span>x
        </div>
        <div class="cnt-l" data-i18n="hero.stat2l">ROI moyen</div>
      </div>
      <div class="cnt-i">
        <div class="cnt-n">
          <span class="count-up" data-target="98" aria-label="98% satisfaction">0</span>%
        </div>
        <div class="cnt-l" data-i18n="hero.stat3l">Satisfaction</div>
      </div>
    </aside>
  </div>
</section>

<style>
/* ── HERO SHELL ─────────────────────────────────────────────── */
.hero {
  min-height: 100svh;
  padding-top: var(--nav-h);
  display: flex;
  align-items: flex-end;
  padding-bottom: clamp(3rem, 5vw, 5.5rem);
  padding-left:  var(--section-px);
  padding-right: var(--section-px);
  position: relative;
  overflow: hidden;
  cursor: crosshair;
}

/* ── BACKGROUNDS ────────────────────────────────────────────── */
.hero-bg {
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse 55% 55% at 68% 38%, rgba(26,47,10,0.9)  0%, transparent 70%),
    radial-gradient(ellipse 40% 40% at 18% 72%, rgba(15,31,31,0.8)  0%, transparent 60%);
  will-change: opacity;
}

.hero-grid {
  position: absolute; inset: 0;
  background-image:
    linear-gradient(rgba(245,242,236,.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(245,242,236,.025) 1px, transparent 1px);
  background-size: 80px 80px;
}

.hero-glow {
  position: absolute;
  bottom: -20%;
  left: 5%;
  width: clamp(300px, 45vw, 700px);
  height: clamp(300px, 45vw, 700px);
  background: radial-gradient(circle, rgba(200,240,62,0.07) 0%, transparent 65%);
  pointer-events: none;
  animation: glow-pulse 6s ease-in-out infinite alternate;
}
@keyframes glow-pulse {
  from { opacity: 0.6; transform: scale(1); }
  to   { opacity: 1;   transform: scale(1.15); }
}

/* ── HUD OVERLAY ────────────────────────────────────────────── */
.hud {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
  color: var(--accent, #c8f03e);
  opacity: 0.45;
}

/* Corner brackets */
.hud-corner {
  position: absolute;
  width: 28px;
  height: 28px;
}
.hud-tl { top: calc(var(--nav-h) + 1.5rem); left:  var(--section-px);
  border-top: 1px solid currentColor; border-left: 1px solid currentColor; }
.hud-tr { top: calc(var(--nav-h) + 1.5rem); right: var(--section-px);
  border-top: 1px solid currentColor; border-right: 1px solid currentColor; }
.hud-bl { bottom: clamp(3rem,5vw,5.5rem);   left:  var(--section-px);
  border-bottom: 1px solid currentColor; border-left: 1px solid currentColor; }
.hud-br { bottom: clamp(3rem,5vw,5.5rem);   right: var(--section-px);
  border-bottom: 1px solid currentColor; border-right: 1px solid currentColor; }

/* Horizontal scan line */
.hud-scan {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg,
    transparent 0%, currentColor 30%, currentColor 70%, transparent 100%);
  opacity: 0.35;
  animation: scan-move 8s linear infinite;
}
@keyframes scan-move {
  0%   { top: calc(var(--nav-h)); opacity: 0; }
  5%   { opacity: 0.35; }
  95%  { opacity: 0.35; }
  100% { top: 100%;    opacity: 0; }
}

/* Data readouts */
.hud-data {
  position: absolute;
  display: flex;
  flex-direction: column;
  gap: 2px;
  font-family: 'Courier New', monospace;
  font-size: 9px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  line-height: 1.6;
}
.hud-data--tl {
  top: calc(var(--nav-h) + 2.2rem);
  left: calc(var(--section-px) + 0.5rem);
}
.hud-data--br {
  bottom: calc(clamp(3rem,5vw,5.5rem) + 0.5rem);
  right: calc(var(--section-px) + 0.5rem);
  align-items: flex-end;
}
.hud-label {
  color: currentColor;
  opacity: 0.5;
  margin-right: 0.4em;
}
.hud-val {
  color: currentColor;
  opacity: 0.9;
}

/* Reticle SVG */
.hud-reticle {
  position: absolute;
  top: calc(var(--nav-h) + 3rem);
  right: calc(var(--section-px) + 2rem);
  width: 60px;
  height: 60px;
  color: var(--accent, #c8f03e);
  animation: reticle-spin 20s linear infinite;
}
@keyframes reticle-spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

/* Progress bar */
.hud-bar-wrap {
  position: absolute;
  bottom: calc(clamp(3rem,5vw,5.5rem) + 0.5rem);
  left: calc(var(--section-px) + 0.5rem);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.hud-bar-track {
  width: clamp(60px, 8vw, 120px);
  height: 1px;
  background: rgba(200,240,62,0.2);
}
.hud-bar-fill {
  height: 100%;
  width: 72%;
  background: currentColor;
  transition: width 1s ease;
}
.hud-bar-label {
  font-family: 'Courier New', monospace;
  font-size: 9px;
  letter-spacing: 0.1em;
  color: currentColor;
  opacity: 0.7;
}

/* ── RIPPLE LAYER ───────────────────────────────────────────── */
.ripple-layer {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  overflow: hidden;
}

/* Individual ripple ring (injected by JS) */
.ripple-ring {
  position: absolute;
  border-radius: 50%;
  border: 1px solid var(--accent, #c8f03e);
  transform: translate(-50%, -50%) scale(0);
  pointer-events: none;
}
.ripple-hex {
  position: absolute;
  width: 0; height: 0;
  pointer-events: none;
}
.ripple-dot {
  position: absolute;
  border-radius: 50%;
  background: var(--accent, #c8f03e);
  transform: translate(-50%, -50%);
  pointer-events: none;
}

/* ── INNER GRID ─────────────────────────────────────────────── */
.hero-inner {
  position: relative;
  z-index: 3;
  width: 100%;
  max-width: min(90vw, 1400px);
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 3rem;
}

.hero-content {
  flex: 1 1 auto;
  min-width: 0;
}

/* Tag */
.hero-tag {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: var(--text-label);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: clamp(1.5rem, 2.5vw, 2.5rem);
}
.hero-tag::before {
  content: '';
  display: block;
  width: 22px; height: 1px;
  background: var(--accent);
  flex-shrink: 0;
}

/* ── HERO TITLE ─────────────────────────────────────────────── */
.hero-title {
  display: flex;
  flex-direction: column;
  gap: 0;
  font-size: var(--text-display);
  font-family: 'Syne', sans-serif;
  font-weight: 700;
  line-height: 0.93;
  letter-spacing: -0.045em;
  margin-bottom: clamp(2rem, 3.5vw, 3.5rem);
}
.ht-line   { display: block; white-space: nowrap; }
.ht-accent { font-style: normal; color: var(--accent); }
.ht-l3.out {
  -webkit-text-stroke: 2px var(--white);
  color: transparent;
}

/* ── BOTTOM ROW ─────────────────────────────────────────────── */
.hero-bot {
  display: flex;
  align-items: center;
  gap: clamp(1.5rem, 3vw, 3rem);
  flex-wrap: wrap;
}
.hero-desc {
  font-size: var(--text-hero-sub);
  color: var(--muted);
  max-width: 380px;
  line-height: 1.75;
  font-weight: 300;
}
.hero-acts {
  display: flex;
  gap: 1rem;
  align-items: center;
  flex-shrink: 0;
  flex-wrap: wrap;
}

/* ── WORKS BUTTON ───────────────────────────────────────────── */
.btn-works {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.65rem 1.4rem;
  border: 1px solid rgba(200, 240, 62, 0.3);
  border-radius: 100px;
  background: transparent;
  color: var(--white, #f5f2ec);
  text-decoration: none;
  font-size: var(--text-label, 0.75rem);
  font-family: 'Syne', sans-serif;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  overflow: hidden;
  transition:
    border-color 0.3s ease,
    color 0.3s ease,
    transform 0.25s cubic-bezier(0.34,1.56,0.64,1);
  will-change: transform;
  cursor: pointer;
  isolation: isolate;
}

/* The magnetic glow blob */
.btn-works__blob {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: radial-gradient(circle at var(--bx, 50%) var(--by, 50%),
    rgba(200,240,62, 0.18) 0%,
    rgba(200,240,62, 0.06) 45%,
    transparent 70%);
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}
.btn-works:hover .btn-works__blob,
.btn-works:focus-visible .btn-works__blob {
  opacity: 1;
}

/* Border glow on hover */
.btn-works:hover,
.btn-works:focus-visible {
  border-color: rgba(200,240,62,0.7);
  color: var(--accent, #c8f03e);
  outline: none;
}

/* Label + arrow */
.btn-works__label {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 0.4rem;
}
.btn-works__arrow {
  transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1);
}
.btn-works:hover .btn-works__arrow {
  transform: translateX(3px);
}

/* Outer ring pulse on hover */
.btn-works::after {
  content: '';
  position: absolute;
  inset: -4px;
  border-radius: 100px;
  border: 1px solid rgba(200,240,62,0);
  transition: border-color 0.3s ease, inset 0.3s ease;
  pointer-events: none;
}
.btn-works:hover::after {
  border-color: rgba(200,240,62,0.2);
  inset: -7px;
}

/* ── STATS ──────────────────────────────────────────────────── */
.hero-stats {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  gap: 2rem;
  align-items: flex-end;
  text-align: right;
  animation: stats-enter 1.2s var(--ease-out) 0.5s both;
}
@keyframes stats-enter {
  from { opacity: 0; transform: translateX(24px); }
  to   { opacity: 1; transform: none; }
}
.cnt-i { text-align: right; }
.cnt-n {
  font-family: 'Syne', sans-serif;
  font-size: clamp(2rem, 3.5vw, 2.8rem);
  font-weight: 800;
  line-height: 1;
  letter-spacing: -0.04em;
  color: var(--white);
}
.cnt-l {
  font-size: var(--text-label);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
  margin-top: 0.25rem;
}

/* ── ENTRANCE ANIMATIONS ────────────────────────────────────── */
.hero-tag, .ht-l1, .ht-l2, .ht-l3, .hero-bot {
  animation: hero-enter 1s var(--ease-out) both;
}
.hero-tag { animation-delay: 0.05s; }
.ht-l1    { animation-delay: 0.15s; }
.ht-l2    { animation-delay: 0.25s; }
.ht-l3    { animation-delay: 0.35s; }
.hero-bot { animation-delay: 0.45s; }

@keyframes hero-enter {
  from { opacity: 0; transform: translateY(28px); }
  to   { opacity: 1; transform: none; }
}

/* ── RESPONSIVE ─────────────────────────────────────────────── */
@media (max-width: 1100px) {
  .hero-stats { display: none; }
  .hero-inner { max-width: 100%; }
  .hud-data--br { display: none; }
}
@media (max-width: 768px) {
  .hud-reticle { display: none; }
  .hud-data--tl { font-size: 8px; }
}
@media (max-width: 640px) {
  .hero-bot { flex-direction: column; align-items: flex-start; gap: 1.2rem; }
  .hero-acts { flex-direction: column; align-items: flex-start; }
  .ht-line { white-space: normal; }
  .hud-scan { display: none; }
  .hud-bar-wrap { display: none; }
  .btn-works { width: 100%; justify-content: space-between; }
}

/* Respect reduced-motion preference */
@media (prefers-reduced-motion: reduce) {
  .hero-glow, .hud-scan, .hud-reticle,
  .hero-tag, .ht-l1, .ht-l2, .ht-l3, .hero-bot, .hero-stats {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
}
</style>

<!-- GSAP CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>

<script>
  // Wait for GSAP to be ready
  document.addEventListener('DOMContentLoaded', () => {
    const gsap = window.gsap;
    if (!gsap) return;

    const hero        = document.getElementById('home');
    const rippleLayer = document.getElementById('rippleLayer');
    const btnWorks    = document.getElementById('btnWorks');
    const worksBlob   = document.getElementById('worksBlob');

    // ── 1. GSAP CLICK RIPPLE ──────────────────────────────────────
    // On each click: burst of 3 rings + a center dot + scattered micro-dots
    function createClickRipple(x, y) {
      // Center impact dot
      const dot = document.createElement('div');
      dot.className = 'ripple-dot';
      dot.style.cssText = `left:${x}px; top:${y}px; width:4px; height:4px;`;
      rippleLayer.appendChild(dot);

      gsap.fromTo(dot,
        { scale: 1, opacity: 0.9 },
        {
          scale: 0, opacity: 0, duration: 0.5, ease: 'power2.out',
          onComplete: () => dot.remove()
        }
      );

      // 3 expanding rings with stagger
      const ringCount = 3;
      const sizes     = [60, 110, 170];
      const delays    = [0, 0.08, 0.18];

      for (let i = 0; i < ringCount; i++) {
        const ring = document.createElement('div');
        ring.className = 'ripple-ring';
        const s = sizes[i];
        ring.style.cssText = `
          left:${x}px; top:${y}px;
          width:${s}px; height:${s}px;
          opacity:0;
        `;
        rippleLayer.appendChild(ring);

        gsap.fromTo(ring,
          { scale: 0.1, opacity: i === 0 ? 0.8 : 0.4 },
          {
            scale: 1,
            opacity: 0,
            duration: 0.7 + i * 0.12,
            delay: delays[i],
            ease: 'power2.out',
            onComplete: () => ring.remove()
          }
        );
      }

      // Micro scattered particles
      const particleCount = 6;
      for (let p = 0; p < particleCount; p++) {
        const pd = document.createElement('div');
        pd.className = 'ripple-dot';
        const angle  = (p / particleCount) * Math.PI * 2;
        const dist   = 20 + Math.random() * 30;
        pd.style.cssText = `
          left:${x}px; top:${y}px;
          width:${1 + Math.random() * 2}px;
          height:${1 + Math.random() * 2}px;
          opacity:0.6;
        `;
        rippleLayer.appendChild(pd);

        gsap.to(pd, {
          x: Math.cos(angle) * dist,
          y: Math.sin(angle) * dist,
          opacity: 0,
          scale: 0,
          duration: 0.5 + Math.random() * 0.3,
          ease: 'power2.out',
          onComplete: () => pd.remove()
        });
      }
    }

    // Only trigger on the hero section itself (not on buttons/links)
    hero.addEventListener('click', (e) => {
      if (e.target.closest('a, button')) return;
      const rect = hero.getBoundingClientRect();
      createClickRipple(e.clientX - rect.left, e.clientY - rect.top);
    });

    // ── 2. HUD AMBIENT ANIMATION ─────────────────────────────────
    // Animate the coordinates to look like live telemetry
    const hudLat = document.getElementById('hud-lat');
    const hudLng = document.getElementById('hud-lng');
    const hudBar = document.getElementById('hud-bar');
    const hudPct = document.getElementById('hud-pct');

    if (hudLat && hudLng) {
      let baseLat = 48.8566, baseLng = 2.3522;

      setInterval(() => {
        baseLat += (Math.random() - 0.5) * 0.0003;
        baseLng += (Math.random() - 0.5) * 0.0003;
        hudLat.textContent = `${baseLat.toFixed(4)}° N`;
        hudLng.textContent = `${baseLng.toFixed(4)}° E`;
      }, 1800);
    }

    if (hudBar && hudPct) {
      let pct = 72;
      setInterval(() => {
        pct = 55 + Math.random() * 40;
        hudBar.style.width = `${pct.toFixed(0)}%`;
        hudPct.textContent = `${pct.toFixed(0)}%`;
      }, 2400);
    }

    // GSAP blink on HUD corners
    gsap.to('.hud-corner', {
      opacity: 0.2,
      duration: 1.5,
      stagger: { each: 0.4, yoyo: true, repeat: -1 },
      ease: 'power1.inOut',
      yoyo: true,
      repeat: -1
    });

    // ── 3. WORKS BUTTON — MAGNETIC BLOB ──────────────────────────
    if (btnWorks && worksBlob) {
      let bounds;
      let rafId = null;

      const updateBounds = () => { bounds = btnWorks.getBoundingClientRect(); };
      updateBounds();
      window.addEventListener('resize', updateBounds, { passive: true });
      window.addEventListener('scroll', updateBounds, { passive: true });

      // Track mouse inside button → update CSS vars for blob position
      btnWorks.addEventListener('mousemove', (e) => {
        if (!bounds) return;
        const relX = ((e.clientX - bounds.left) / bounds.width)  * 100;
        const relY = ((e.clientY - bounds.top)  / bounds.height) * 100;
        worksBlob.style.setProperty('--bx', `${relX}%`);
        worksBlob.style.setProperty('--by', `${relY}%`);
      });

      // Magnetic pull: button moves slightly toward cursor
      let isHovered = false;

      btnWorks.addEventListener('mouseenter', (e) => {
        isHovered = true;
        bounds = btnWorks.getBoundingClientRect();
      });

      btnWorks.addEventListener('mouseleave', () => {
        isHovered = false;
        // Spring back to origin
        gsap.to(btnWorks, {
          x: 0,
          y: 0,
          duration: 0.6,
          ease: 'elastic.out(1, 0.4)'
        });
      });

      // Magnetic movement on surrounding area
      document.addEventListener('mousemove', (e) => {
        if (!isHovered) return;
        if (!bounds) return;

        const btnCx = bounds.left + bounds.width  / 2;
        const btnCy = bounds.top  + bounds.height / 2;
        const dx = e.clientX - btnCx;
        const dy = e.clientY - btnCy;

        // Strength: max ±8px movement
        const maxMov = 8;
        const strength = 0.35;
        const moveX = Math.max(-maxMov, Math.min(maxMov, dx * strength));
        const moveY = Math.max(-maxMov, Math.min(maxMov, dy * strength));

        gsap.to(btnWorks, {
          x: moveX,
          y: moveY,
          duration: 0.35,
          ease: 'power2.out',
          overwrite: 'auto'
        });
      });

      // Click effect on works button
      btnWorks.addEventListener('click', (e) => {
        e.preventDefault(); // Remove in production if navigation is desired
        gsap.timeline()
          .to(btnWorks, { scale: 0.93, duration: 0.1, ease: 'power2.in' })
          .to(btnWorks, { scale: 1,    duration: 0.5, ease: 'elastic.out(1.2, 0.4)' })
          .call(() => { window.location.href = '/works'; }, null, 0.15);
      });
    }

    // ── 4. COUNT-UP ANIMATION (intersection-triggered) ───────────
    const countEls = document.querySelectorAll('.count-up');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          const el     = entry.target;
          const target = parseInt(el.dataset.target, 10);
          const obj    = { val: 0 };
          gsap.to(obj, {
            val: target,
            duration: 1.8,
            ease: 'power2.out',
            delay: 0.3,
            onUpdate: () => { el.textContent = Math.round(obj.val); }
          });
          io.unobserve(el);
        });
      }, { threshold: 0.4 });
      countEls.forEach(el => io.observe(el));
    }
  });
</script>