---
// src/components/Footer.astro
---

<!-- ── CONTACT FORM SECTION ─────────────────────────────────── -->
<section class="contact-sec" id="contact" aria-labelledby="contact-title">
  <div class="contact-inner">

    <div class="contact-head rv">
      <div class="sec-label" data-i18n="cta.label">Passons à l'action</div>
      <h2 class="sec-title" id="contact-title" data-i18n-html="cta.title">
        Votre site mérite<br>mieux qu'hier.
      </h2>
      <p class="contact-sub" data-i18n="cta.desc">
        Audit gratuit, stratégie claire, résultats mesurables.
      </p>
    </div>

    <!-- Form -->
    <form
      class="cf rv d1"
      id="contact-form"
      novalidate
      aria-label="Formulaire de contact"
    >
      <div class="cf-row">
        <div class="cf-field">
          <label class="cf-label" for="cf-name" data-i18n="form.nameLabel">Nom</label>
          <input
            id="cf-name"
            name="name"
            type="text"
            class="cf-input"
            placeholder="Jean Dupont"
            autocomplete="name"
            required
            aria-required="true"
          />
          <span class="cf-err" id="err-name" role="alert" aria-live="polite"></span>
        </div>
        <div class="cf-field">
          <label class="cf-label" for="cf-email" data-i18n="form.emailLabel">Email</label>
          <input
            id="cf-email"
            name="email"
            type="email"
            class="cf-input"
            placeholder="vous@domaine.com"
            autocomplete="email"
            required
            aria-required="true"
          />
          <span class="cf-err" id="err-email" role="alert" aria-live="polite"></span>
        </div>
      </div>

      <div class="cf-field">
        <label class="cf-label" for="cf-msg" data-i18n="form.msgLabel">Message</label>
        <textarea
          id="cf-msg"
          name="message"
          class="cf-input cf-ta"
          placeholder="Décrivez votre projet en quelques lignes…"
          rows="4"
          required
          aria-required="true"
        ></textarea>
        <span class="cf-err" id="err-msg" role="alert" aria-live="polite"></span>
      </div>

      <!-- Honeypot anti-spam (caché aux humains) -->
      <input type="text" name="_hp" class="cf-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="cf-foot">
        <button type="submit" class="btn-p cf-btn" id="cf-submit">
          <span class="cf-btn-label" data-i18n="form.submit">Envoyer le message</span>
          <svg class="cf-arrow" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M7 17L17 7M17 7H7M17 7v10"/>
          </svg>
          <!-- Spinner (caché par défaut) -->
          <svg class="cf-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
          </svg>
        </button>
        <p class="cf-mention" data-i18n="form.mention">Réponse sous 24h · Zéro spam</p>
      </div>

      <!-- Success / Error banners -->
      <div class="cf-banner cf-ok" id="cf-ok" role="status" aria-live="polite" hidden>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
        <span data-i18n="form.success">Message envoyé ! On revient vers vous sous 24h.</span>
      </div>
      <div class="cf-banner cf-ko" id="cf-ko" role="alert" aria-live="assertive" hidden>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
        <span data-i18n="form.error">Une erreur est survenue. Réessayez ou écrivez-nous directement.</span>
      </div>
    </form>

  </div>
</section>

<!-- ── FOOTER ────────────────────────────────────────────────── -->
<footer>
  <div class="f-brand">
    <a class="f-logo" href="/" aria-label="Evolus — Accueil">
      evolus<span class="logo-dot">.</span>
    </a>
    <span class="f-copy" data-i18n="footer.copy">© 2025 Evolus Agency</span>
  </div>

  <nav aria-label="Footer navigation">
    <ul class="f-links" role="list">
      <li><a href="#services" data-i18n="footer.links.0.label">Services</a></li>
      <li><a href="/blog"     data-i18n="footer.links.1.label">Blog</a></li>
      <li>
        <a href="mailto:contact@evolus.agency" data-i18n="footer.links.2.label">Contact</a>
      </li>
    </ul>
  </nav>
</footer>

<!-- ── STYLES ─────────────────────────────────────────────────── -->
<style>
/* ── Contact section ── */
.contact-sec {
  background: var(--black);
  padding: var(--section-py) var(--section-px);
  position: relative;
  overflow: hidden;
}

/* Subtle ambient glow from the bottom-center */
.contact-sec::before {
  content: '';
  position: absolute;
  bottom: -10%;
  left: 50%;
  transform: translateX(-50%);
  width: clamp(300px, 50vw, 600px);
  height: clamp(300px, 50vw, 600px);
  background: radial-gradient(circle, rgba(200,240,62,0.05) 0%, transparent 65%);
  pointer-events: none;
}

.contact-inner {
  max-width: 680px;
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

.contact-head {
  margin-bottom: clamp(2rem, 3.5vw, 3.5rem);
}

.contact-sub {
  font-size: var(--text-hero-sub);
  color: var(--muted);
  max-width: 400px;
  line-height: 1.75;
  font-weight: 300;
  margin-top: 0.8rem;
}

/* ── Form layout ── */
.cf {
  display: flex;
  flex-direction: column;
  gap: 1.2rem;
}

.cf-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.2rem;
}

.cf-field {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.cf-label {
  font-size: var(--text-label);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
}

.cf-input {
  font-family: 'DM Sans', sans-serif;
  font-size: var(--text-body);
  background: var(--card);
  color: var(--white);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 0.75rem 1rem;
  outline: none;
  transition:
    border-color var(--dur-fast),
    box-shadow   var(--dur-fast);
  width: 100%;
  resize: none;
}

.cf-input::placeholder {
  color: var(--muted-light);
  font-weight: 300;
}

.cf-input:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(200,240,62,0.12);
}

/* Error state */
.cf-input.has-error {
  border-color: #e05252;
  box-shadow: 0 0 0 3px rgba(224,82,82,0.12);
}

.cf-ta {
  line-height: 1.6;
}

.cf-err {
  font-size: var(--text-small);
  color: #e05252;
  min-height: 1em;
  display: block;
}

/* Honeypot */
.cf-hp {
  position: absolute;
  opacity: 0;
  height: 0;
  width: 0;
  pointer-events: none;
}

/* Footer row inside form */
.cf-foot {
  display: flex;
  align-items: center;
  gap: 1.2rem;
  flex-wrap: wrap;
  margin-top: 0.4rem;
}

.cf-btn {
  min-width: 200px;
  justify-content: center;
}

.cf-mention {
  font-size: var(--text-small);
  color: var(--muted);
}

/* Spinner — hidden by default */
.cf-spin { display: none; animation: spin 0.8s linear infinite; }
.cf-btn.loading .cf-arrow { display: none; }
.cf-btn.loading .cf-spin  { display: block; }
.cf-btn.loading            { opacity: 0.7; pointer-events: none; }
@keyframes spin { to { transform: rotate(360deg); } }

/* Banners */
.cf-banner {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.85rem 1.1rem;
  border-radius: 10px;
  font-size: var(--text-body);
  font-weight: 400;
}
.cf-banner[hidden] { display: none; }

.cf-ok {
  background: rgba(200,240,62,0.1);
  border: 1px solid rgba(200,240,62,0.25);
  color: var(--accent);
}

.cf-ko {
  background: rgba(224,82,82,0.1);
  border: 1px solid rgba(224,82,82,0.25);
  color: #e05252;
}

/* ── Footer (unchanged) ── */
footer {
  border-top: 1px solid var(--border);
  padding: 2rem var(--section-px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--black);
  gap: 1.5rem;
  flex-wrap: wrap;
}

.f-brand {
  display: flex;
  align-items: center;
  gap: 1.5rem;
}

.f-logo {
  font-family: 'Syne', sans-serif;
  font-weight: 800;
  font-size: 1.1rem;
  letter-spacing: -0.02em;
  color: var(--white);
  cursor: none;
}
.logo-dot { color: var(--accent); }

.f-copy {
  font-size: var(--text-label);
  color: var(--muted);
}

.f-links {
  display: flex;
  gap: 1.5rem;
  list-style: none;
}

.f-links a {
  font-size: var(--text-label);
  color: var(--muted);
  transition: color var(--dur-fast);
  cursor: none;
}
.f-links a:hover { color: var(--white); }

/* ── Responsive ── */
@media (max-width: 640px) {
  .cf-row { grid-template-columns: 1fr; }
  .cf-foot { flex-direction: column; align-items: flex-start; }
  .cf-btn  { width: 100%; }

  footer {
    flex-direction: column;
    text-align: center;
    padding: 2rem 1.5rem;
  }
  .f-brand { flex-direction: column; gap: 0.5rem; }
}
</style>

<!-- ── SCRIPT ─────────────────────────────────────────────────── -->
<script>
(function () {
  const form    = document.getElementById('contact-form');
  const btn     = document.getElementById('cf-submit');
  const bannerOk = document.getElementById('cf-ok');
  const bannerKo = document.getElementById('cf-ko');

  // ── Inline validation helpers ──────────────────────────────
  function showErr(id, msg) {
    const el = document.getElementById(id);
    const input = el?.previousElementSibling;
    if (el)    el.textContent = msg;
    if (input) input.classList.toggle('has-error', !!msg);
  }

  function validate(data) {
    let ok = true;
    if (!data.name.trim()) {
      showErr('err-name', 'Votre nom est requis.'); ok = false;
    } else { showErr('err-name', ''); }

    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRe.test(data.email)) {
      showErr('err-email', 'Email invalide.'); ok = false;
    } else { showErr('err-email', ''); }

    if (data.message.trim().length < 10) {
      showErr('err-msg', 'Message trop court (min. 10 caractères).'); ok = false;
    } else { showErr('err-msg', ''); }

    return ok;
  }

  // ── Submit ─────────────────────────────────────────────────
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const fd = new FormData(form);
    const data = {
      name:    fd.get('name')?.toString()    ?? '',
      email:   fd.get('email')?.toString()   ?? '',
      message: fd.get('message')?.toString() ?? '',
      _hp:     fd.get('_hp')?.toString()     ?? '',
    };

    // Honeypot check
    if (data._hp) return;

    if (!validate(data)) return;

    // Loading state
    btn?.classList.add('loading');
    bannerOk.hidden = true;
    bannerKo.hidden = true;

    try {
      const res = await fetch('/api/contact', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify(data),
      });

      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      bannerOk.hidden = false;
      form.reset();

      // Scroll banner into view on mobile
      bannerOk.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    } catch (err) {
      console.error('[contact form]', err);
      bannerKo.hidden = false;
    } finally {
      btn?.classList.remove('loading');
    }
  });

  // ── Clear error on input ───────────────────────────────────
  form?.querySelectorAll('.cf-input').forEach(input => {
    input.addEventListener('input', () => {
      const errId = 'err-' + input.id.replace('cf-', '');
      showErr(errId, '');
    });
  });
})();
</script>
