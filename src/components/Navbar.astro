---
// src/components/Navbar.astro
// Fixed top navigation with logo, links, and CTA button.
// Logo: inline SVG (optimized) — best for Astro because:
//   • No extra HTTP request (unlike <img src="logo.svg">)
//   • Fully styleable via CSS (stroke color via currentColor)
//   • Accessible: aria-label on the <a>, title inside SVG
//   • Smaller payload than loading an Asset via import + Astro's image pipeline
//     (which is better suited to raster images)
//   • SVGO-optimized: removed editor metadata, merged groups, dropped xmlns:xlink
---

<nav aria-label="Main navigation">
  <!-- LOGO -->
  <a class="logo" href="/" aria-label="Evolus — Retour à l'accueil">
  <svg
  viewBox="0 0 680 700"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
  width="30"
  height="30"
>
  <g transform="translate(340,300)" fill="#c8f03e">
    <!-- Chevron 1 -->
    <polygon points="-195,-230 0,-310 195,-230 195,-195 0,-275 -195,-195" />
    <polygon points="-155,-215 0,-285 155,-215 155,-190 0,-260 -155,-190" fill="#ffff" />
    <!-- Chevron 2 -->
    <polygon points="-195,-140 0,-220 195,-140 195,-105 0,-185 -195,-105" />
    <polygon points="-155,-125 0,-200 155,-125 155,-100 0,-175 -155,-100" fill="#ffff" />
    <!-- Chevron 3 -->
    <polygon points="-195,-50 0,-130 195,-50 195,-15 0,-95 -195,-15" />
    <polygon points="-155,-35 0,-110 155,-35 155,-10 0,-85 -155,-10" fill="#ffff" />
    <!-- A triangulaire -->
    <polygon points="10,35 10,35 -155,270 -205,270" />
    <polygon points="10,35 10,35 205,270 155,270" />
    <rect x="-95" y="143" width="190" height="38" rx="-5"/>
  </g>
</svg>
  <span class="logo-text">evolus<span class="logo-dot">.</span></span>
</a>

  <!-- NAV LINKS -->
  <ul class="nav-links" role="list">
    <li><a href="#services"  data-i18n="nav.services" class="nav-link">Services</a></li>
    <li><a href="#process"   data-i18n="nav.process"  class="nav-link">Process</a></li>
    <li><a href="/blog"      data-i18n="nav.blog"     class="nav-link">Blog</a></li>
    <li><a href="#contact"   data-i18n="nav.contact"  class="nav-link">Contact</a></li>
  </ul>

  <!-- CTA -->
  <a class="nav-cta btn-p" href="#contact" data-i18n="nav.cta">Démarrer →</a>
</nav>

<style>
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 500;
  height: var(--nav-h);
  padding: 0 var(--section-px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  border-bottom: 1px solid var(--border);
  background: rgba(10, 10, 10, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  /* Prevent CLS: nav is always 72px tall */
  contain: layout style;
}

/* LOGO */
.logo {
  font-family: 'Syne', sans-serif;
  font-weight: 800;
  font-size: 1.3rem;
  letter-spacing: -0.02em;
  color: var(--white);
  display: flex;
  align-items: center;
  gap: 0.5rem;
  cursor: none;
  flex-shrink: 0;
}
.logo-text { line-height: 1; }
.logo-dot  { color: var(--accent); }

/* NAV LINKS */
.nav-links {
  display: flex;
  gap: 2rem;
  list-style: none;
  margin: 0 auto; /* center between logo and CTA */
}
.nav-link {
  font-size: 0.87rem;
  color: var(--muted);
  transition: color var(--dur-fast);
  cursor: none;
  position: relative;
  padding-bottom: 2px;
}
.nav-link::after {
  content: '';
  position: absolute;
  bottom: -2px; left: 0;
  width: 0; height: 1px;
  background: var(--accent);
  transition: width var(--dur-mid) var(--ease-out);
}
.nav-link:hover            { color: var(--white); }
.nav-link:hover::after     { width: 100%; }
.nav-link[aria-current="page"] { color: var(--white); }

/* CTA — inherits .btn-p but with tighter padding */
.nav-cta {
  font-size: 0.85rem;
  padding: 0.55rem 1.3rem;
  flex-shrink: 0;
}

/* LANG SWITCHER (fixed position, defined here for encapsulation) */
:global(.lang-sw) {
  position: fixed;
  top: 50%;
  right: 1rem;
  transform: translateY(-50%);
  z-index: 600;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}
:global(.lb) {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  border: 1px solid var(--border);
  background: rgba(10, 10, 10, 0.85);
  color: var(--muted);
  font-family: 'Syne', sans-serif;
  font-size: 0.6rem;
  font-weight: 700;
  cursor: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background var(--dur-fast), border-color var(--dur-fast), color var(--dur-fast);
}
:global(.lb.on) {
  background: var(--accent);
  color: var(--black);
  border-color: var(--accent);
}
:global(.lb:hover:not(.on)) {
  border-color: var(--accent);
  color: var(--white);
}

/* MOBILE */
@media (max-width: 768px) {
  .nav-links { display: none; }
  nav { padding: 0 1.2rem; }
}
</style>
