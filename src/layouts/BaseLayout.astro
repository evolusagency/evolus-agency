---
// src/layouts/BaseLayout.astro
// Base layout: <head>, fonts, global CSS, noise overlay, custom cursor
import '../styles/global.css';

interface Props {
  title:       string;
  description: string;
  lang?:       string;
}

const { title, description, lang = 'fr' } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang} id="html-root">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <meta http-equiv="X-UA-Compatible" content="ie=edge" />
  <title>{title}</title>
  
  <!-- Primary Meta Tags -->
  <meta name="description" content={description} />
  <link rel="canonical" href={`https://evolus.agency${Astro.url.pathname}`} />
  
  <!-- SEO & Robots -->
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="language" content={lang === 'fr' ? 'French' : 'English'} />
  <meta name="revisit-after" content="7 days" />
  
  <!-- Open Graph -->
  <meta property="og:site_name" content="Evolus Agency" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`https://evolus.agency${Astro.url.pathname}`} />
  <meta property="og:image" content="https://evolus.agency/og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://evolus.agency/og-image.jpg" />
  
  <!-- Branding -->
  <meta name="theme-color" content="#c8f03e" />
  <meta name="msapplication-TileColor" content="#0a0a0a" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Evolus" />
  
  <!-- Performance & Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="dns-prefetch" href="https://ipapi.co" />
  
  <!-- Favicon & Icons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.json" />
  
  <!-- Fonts with display=swap for LCP -->
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500&display=swap" />

  <!-- Google Translate Script -->
  <script type="text/javascript">
    function googleTranslateElementInit() {
      new google.translate.TranslateElement({
        pageLanguage: 'fr',
        includedLanguages: 'fr,en,es,de,it,pt,nl',
        layout: google.translate.TranslateElement.InlineLayout.SIMPLE
      }, 'google_translate_element');
    }
  </script>
  <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
</head>
<body>

  <!-- Custom cursor -->
  <div class="cur" id="cur" aria-hidden="true"></div>

  <!-- Lang switcher — teleported to fixed position via CSS -->
  <div class="lang-sw" role="group" aria-label="Language selector">
    <button class="lb" id="lb-fr" aria-label="Français" aria-pressed="true">FR</button>
    <button class="lb" id="lb-en" aria-label="English"  aria-pressed="false">EN</button>
  </div>

  <slot />

  <!-- Auto-detect country and enable Google Translate -->
  <script>
    async function autoDetectAndTranslate() {
      try {
        // Check if user has already set language via buttons
        const savedLang = localStorage.getItem('lang');
        if (savedLang && (savedLang === 'fr' || savedLang === 'en')) {
          return; // User manually set language, don't override
        }

        // Detect country from IP
        const response = await fetch('https://ipapi.co/json/', {
          method: 'GET',
          headers: { 'Accept': 'application/json' }
        });
        const data = await response.json();
        const countryCode = data.country_code;

        // Detect browser language
        const browserLang = navigator.language?.split('-')[0]?.toLowerCase();

        // Auto-translate if user is not from FR/BE/CH/LU/CA
        const frenchCountries = ['FR', 'BE', 'CH', 'LU', 'CA', 'BJ', 'BF', 'CD', 'CI', 'GA', 'GN', 'ML', 'NE', 'SN', 'TG'];
        const englishCountries = ['US', 'GB', 'AU', 'CA', 'IE', 'NZ', 'ZA', 'IN', 'SG', 'HK'];
        
        // Wait a moment for Google Translate to load
        setTimeout(() => {
          if (frenchCountries.includes(countryCode)) {
            // French-speaking country
            return;
          } else if (englishCountries.includes(countryCode) && browserLang !== 'fr') {
            // English-speaking country, trigger English translation
            const selectElement = document.querySelector('.goog-te-combo');
            if (selectElement) {
              selectElement.value = 'en';
              selectElement.dispatchEvent(new Event('change'));
            }
          } else if (browserLang && browserLang !== 'fr' && browserLang !== 'en') {
            // Other language - try to translate to user's browser language if available
            const supportedLangs = ['es', 'de', 'it', 'pt', 'nl'];
            if (supportedLangs.includes(browserLang)) {
              const selectElement = document.querySelector('.goog-te-combo');
              if (selectElement) {
                selectElement.value = browserLang;
                selectElement.dispatchEvent(new Event('change'));
              }
            }
          }
        }, 1500);
      } catch (error) {
        console.log('Geolocation failed, using browser language');
      }
    }

    // Run after document is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', autoDetectAndTranslate);
    } else {
      autoDetectAndTranslate();
    }
  </script>

  <!-- Neon Line Canvas Background -->
  <script>
(function() {
  'use strict';

  // ==================== CONFIG ====================
  const CONFIG = {
    maxParticles: 60,
    particleSpawnRadius: 80,
    particlesPerMove: 2,
    mousethrottleMs: 16,
    lerpFactor: 0.06,
    turns: 2,
    amplitude: 0.15, // 15% of canvas width
    glowLayers: [
      { width: 12, alpha: 0.08 },
      { width: 6, alpha: 0.15 },
      { width: 3, alpha: 0.4 },
      { width: 1.5, alpha: 0.9 },
    ],
    colors: [
      { pos: 0, hex: '#c8f03e' },    // green-yellow
      { pos: 0.33, hex: '#a0e0ff' }, // cyan
      { pos: 0.66, hex: '#c8f03e' }, // green-yellow
      { pos: 1, hex: '#c8f03e' },
    ],
    particleLifetime: [60, 120],
    particleRadius: [1, 3],
    pulseRadius: 15,
    mouseAttractionRange: 100,
    mouseAttractionStrength: 0.15,
  };

  // ==================== STATE ====================
  let canvas, ctx;
  let scrollProgress = 0;
  let targetScrollProgress = 0;
  let particles = [];
  let lastMouseTime = 0;
  let mouseX = 0, mouseY = 0;
  let isDirty = false;
  let rafId = null;

  // ==================== UTILS ====================
  function hexToRgb(hex) {
    const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
    return result ? {
      r: parseInt(result[1], 16),
      g: parseInt(result[2], 16),
      b: parseInt(result[3], 16)
    } : { r: 200, g: 240, b: 62 };
  }

  function lerpColor(colors, t) {
    t = Math.max(0, Math.min(1, t));
    for (let i = 0; i < colors.length - 1; i++) {
      if (t >= colors[i].pos && t <= colors[i + 1].pos) {
        const range = colors[i + 1].pos - colors[i].pos;
        const localT = (t - colors[i].pos) / range;
        const c1 = hexToRgb(colors[i].hex);
        const c2 = hexToRgb(colors[i + 1].hex);
        return `rgb(${Math.round(c1.r + (c2.r - c1.r) * localT)}, ${Math.round(c1.g + (c2.g - c1.g) * localT)}, ${Math.round(c1.b + (c2.b - c1.b) * localT)})`;
      }
    }
    return hexToRgb(colors[colors.length - 1].hex);
  }

  function lerp(a, b, t) {
    return a + (b - a) * t;
  }

  // ==================== PARTICLES ====================
  function spawnParticle(x, y, color) {
    if (particles.length >= CONFIG.maxParticles) return;
    
    const radius = CONFIG.particleRadius[0] + Math.random() * (CONFIG.particleRadius[1] - CONFIG.particleRadius[0]);
    const lifetime = CONFIG.particleLifetime[0] + Math.random() * (CONFIG.particleLifetime[1] - CONFIG.particleLifetime[0]);
    
    particles.push({
      x,
      y,
      vx: (Math.random() - 0.5) * 0.6,
      vy: -0.3 - Math.random() * 0.5,
      radius,
      lifetime,
      age: 0,
      color,
    });
    isDirty = true;
  }

  function updateParticles() {
    particles = particles.filter(p => {
      p.age++;
      p.x += p.vx;
      p.y += p.vy;
      return p.age < p.lifetime;
    });
    
    if (particles.length === 0) isDirty = false;
  }

  function drawParticles() {
    particles.forEach(p => {
      const opacity = 0.8 * (1 - p.age / p.lifetime);
      ctx.fillStyle = p.color.replace('rgb', 'rgba').replace(')', `, ${opacity})`);
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
      ctx.fill();
    });
  }

  // ==================== NEON LINE ====================
  function getLineColor(progress) {
    return lerpColor(CONFIG.colors, progress);
  }

  function getLinePoint(progress) {
    const x = canvas.width / 2;
    const amplitude = canvas.width * CONFIG.amplitude;
    const offset = amplitude * Math.sin(progress * Math.PI * CONFIG.turns);
    
    // Mouse attraction
    if (Math.abs(mouseX - x) < CONFIG.mouseAttractionRange && mouseY > canvas.height * 0.2) {
      const dist = Math.abs(mouseX - x);
      const pull = CONFIG.mouseAttractionStrength * (1 - dist / CONFIG.mouseAttractionRange);
      return {
        x: x + offset + (mouseX - x) * pull,
        y: progress * canvas.height,
      };
    }
    
    return { x: x + offset, y: progress * canvas.height };
  }

  function drawNeonLine() {
    const startY = 0;
    const endY = canvas.height;
    const steps = Math.max(100, canvas.height / 4);

    for (let layerIdx = 0; layerIdx < CONFIG.glowLayers.length; layerIdx++) {
      const layer = CONFIG.glowLayers[layerIdx];
      ctx.lineWidth = layer.width;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';

      for (let i = 0; i < steps; i++) {
        const progress = i / steps;
        const point = getLinePoint(progress);
        const color = getLineColor(progress);

        ctx.strokeStyle = color.replace('rgb', 'rgba').replace(')', `, ${layer.alpha})`);
        ctx.shadowBlur = 20;
        ctx.shadowColor = color;

        if (i === 0) {
          ctx.beginPath();
          ctx.moveTo(point.x, point.y);
        } else {
          ctx.lineTo(point.x, point.y);
        }
      }
      ctx.stroke();
    }
  }

  function drawPulseTip() {
    const tipPoint = getLinePoint(scrollProgress);
    const baseRadius = CONFIG.pulseRadius;
    const pulse = Math.sin(Date.now() * 0.006) * 0.3 + 0.7;
    const pulseRadius = baseRadius * pulse;
    const color = getLineColor(scrollProgress);

    ctx.fillStyle = color.replace('rgb', 'rgba').replace(')', ', 0.4)');
    ctx.shadowBlur = 30;
    ctx.shadowColor = color;
    ctx.beginPath();
    ctx.arc(tipPoint.x, tipPoint.y, pulseRadius, 0, Math.PI * 2);
    ctx.fill();

    // Outer ring
    ctx.strokeStyle = color.replace('rgb', 'rgba').replace(')', ', 0.2)');
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(tipPoint.x, tipPoint.y, baseRadius * 1.5, 0, Math.PI * 2);
    ctx.stroke();
  }

  // ==================== RENDER ====================
  function render() {
    if (!isDirty && particles.length === 0) {
      rafId = null;
      return;
    }

    ctx.clearRect(0, 0, canvas.width, canvas.height);
    
    drawNeonLine();
    drawPulseTip();
    updateParticles();
    drawParticles();

    rafId = requestAnimationFrame(render);
  }

  function scheduleRender() {
    isDirty = true;
    if (!rafId) rafId = requestAnimationFrame(render);
  }

  // ==================== SCROLL ====================
  function updateScroll() {
    const scrollHeight = document.body.scrollHeight - window.innerHeight;
    targetScrollProgress = scrollHeight > 0 ? window.scrollY / scrollHeight : 0;

    if (Math.abs(scrollProgress - targetScrollProgress) > 0.001) {
      scrollProgress = lerp(scrollProgress, targetScrollProgress, CONFIG.lerpFactor);
      scheduleRender();
    }
  }

  // ==================== MOUSE ====================
  function onMouseMove(e) {
    mouseX = e.clientX;
    mouseY = e.clientY;
    isDirty = true;

    const now = Date.now();
    if (now - lastMouseTime >= CONFIG.mousethrottleMs) {
      lastMouseTime = now;

      // Spawn particles only in lower 80% of viewport
      if (mouseY > window.innerHeight * 0.2) {
        for (let i = 0; i < CONFIG.particlesPerMove; i++) {
          const angle = Math.random() * Math.PI * 2;
          const dist = Math.random() * CONFIG.particleSpawnRadius;
          const x = mouseX + Math.cos(angle) * dist;
          const y = mouseY + Math.sin(angle) * dist;
          
          // Get nearest line point color
          const lineProgress = y / canvas.height;
          const color = getLineColor(Math.max(0, Math.min(1, lineProgress)));
          spawnParticle(x, y, color);
        }
      }
    }

    scheduleRender();
  }

  // ==================== INIT ====================
  function init() {
    if (document.querySelector('canvas.neon-line')) {
      console.warn('[neon] Canvas already exists');
      return;
    }

    canvas = document.createElement('canvas');
    canvas.className = 'neon-line';
    canvas.style.cssText = `
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 1;
    `;

    ctx = canvas.getContext('2d', { alpha: true });
    document.body.insertBefore(canvas, document.body.firstChild);

    // Resize handler
    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
      scheduleRender();
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    // Event listeners
    window.addEventListener('scroll', updateScroll, { passive: true });
    window.addEventListener('mousemove', onMouseMove, { passive: true });

    // Safety checks
    setTimeout(() => {
      const firstSec = document.querySelector('.sec, [role="main"], main');
      const navZIndex = parseInt(window.getComputedStyle(document.querySelector('nav')).zIndex) || 500;
      
      if (firstSec) {
        const secZIndex = parseInt(window.getComputedStyle(firstSec).zIndex) || 10;
        if (secZIndex <= 1) {
          console.warn('[neon] Detected z-index conflict, correcting to -1');
          canvas.style.zIndex = -1;
        }
      }

      // Verify pointer-events
      if (window.getComputedStyle(canvas).pointerEvents !== 'none') {
        canvas.style.pointerEvents = 'none';
        console.warn('[neon] Corrected pointer-events: none');
      }

      console.log('[neon] canvas injected, z-index: ' + window.getComputedStyle(canvas).zIndex + ', pointer-events: none');
    }, 100);

    // Start animation loop
    scheduleRender();
  }

  // ==================== DOMContentLoaded ====================
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
  </script>

</body>
</html>
