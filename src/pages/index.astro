// ─── STATE ────────────────────────────────────────────────────
let lang: Lang = 'fr';

// ─── APPLY LANG ───────────────────────────────────────────────
function applyLang(): void {
  const t = T[lang];
  const root = document.documentElement;

  // HTML lang attribute
  root.lang = lang;

  // Update meta tags
  document.title = t['meta.title'] ?? document.title;
  const metaDesc = document.querySelector<HTMLMetaElement>('meta[name="description"]');
  if (metaDesc) metaDesc.content = t['meta.description'] ?? '';

  // textContent nodes (data-i18n)
  document.querySelectorAll<HTMLElement>('[data-i18n]').forEach(el => {
    const key = el.getAttribute('data-i18n')!;
    if (t[key] !== undefined) el.textContent = t[key];
  });

  // innerHTML nodes (data-i18n-html) — used only for titles with <br>
  document.querySelectorAll<HTMLElement>('[data-i18n-html]').forEach(el => {
    const key = el.getAttribute('data-i18n-html')!;
    if (t[key] !== undefined) el.innerHTML = t[key];
  });

  // Marquee — rebuild with current lang items
  const mqEl = document.getElementById('mq');
  if (mqEl && t['marquee']) {
    const items = t['marquee'].split('|');
    const doubled = [...items, ...items]; // seamless loop
    mqEl.innerHTML = doubled
      .map(i => `<span class="mq-item">${i}</span>`)
      .join('');
  }

  // Lang buttons aria-pressed
  const btnFr = document.getElementById('lb-fr');
  const btnEn = document.getElementById('lb-en');
  if (btnFr) {
    btnFr.classList.toggle('on', lang === 'fr');
    btnFr.setAttribute('aria-pressed', String(lang === 'fr'));
  }
  if (btnEn) {
    btnEn.classList.toggle('on', lang === 'en');
    btnEn.setAttribute('aria-pressed', String(lang === 'en'));
  }
}

function setLang(l: Lang): void {
  lang = l;
  try { localStorage.setItem('evolus_lang', l); } catch {}
  applyLang();
}

// Wire lang buttons
document.getElementById('lb-fr')?.addEventListener('click', () => setLang('fr'));
document.getElementById('lb-en')?.addEventListener('click', () => setLang('en'));

// ─── AUTO-DETECT LANGUAGE ─────────────────────────────────────
(function detectLang(): void {
  // 1. User saved preference
  try {
    const saved = localStorage.getItem('evolus_lang') as Lang | null;
    if (saved === 'fr' || saved === 'en') {
      lang = saved;
      applyLang();
      return;
    }
  } catch {}

  // 2. Browser navigator.language
  const bl = (navigator.language ?? navigator.languages?.[0] ?? 'en').toLowerCase();
  const frPrefixes = ['fr', 'be', 'ch', 'ca', 'lu', 'mc', 'sn', 'ci', 'cm', 'mg', 'dz', 'ma', 'tn'];
  lang = frPrefixes.some(c => bl.startsWith(c) || bl.includes('-' + c)) ? 'fr' : 'en';
  applyLang();

  // 3. IP geolocation fallback (non-blocking, best-effort)
  const frCountries = new Set([
    'fr','be','ch','ca','lu','mc','sn','ci','cm','mg','dz','ma','tn',
    'bf','bj','cd','cg','ga','gn','ml','ne','rw','td','tg',
  ]);
  fetch('https://ipapi.co/json/', { signal: AbortSignal.timeout(3000) })
    .then(r => r.json())
    .then((d: { country_code?: string }) => {
      try { if (localStorage.getItem('evolus_lang')) return; } catch {}
      const cc = (d.country_code ?? '').toLowerCase();
      lang = frCountries.has(cc) ? 'fr' : 'en';
      applyLang();
    })
    .catch(() => {}); // fail silently
})();

// ─── CUSTOM CURSOR ────────────────────────────────────────────
const cursor = document.getElementById('cur');
if (cursor && window.matchMedia('(pointer: fine)').matches) {
  // Only on mouse devices — hide cursor div on touch
  let cx = 0, cy = 0;
  let tx = 0, ty = 0;

  document.addEventListener('mousemove', e => {
    tx = e.clientX;
    ty = e.clientY;
    cursor.style.left = tx + 'px';
    cursor.style.top  = ty + 'px';
  });

  document.addEventListener('mouseleave', () => cursor.classList.add('off'));
  document.addEventListener('mouseenter', () => cursor.classList.remove('off'));

  const hoverTargets = 'a, button, .svc-card, .step, .tsti-card, .res-card';
  document.querySelectorAll<HTMLElement>(hoverTargets).forEach(el => {
    el.addEventListener('mouseenter', () => cursor.classList.add('h'));
    el.addEventListener('mouseleave', () => cursor.classList.remove('h'));
  });
} else {
  // Touch device: hide cursor element entirely
  if (cursor) cursor.style.display = 'none';
  document.body.style.cursor = 'auto';
}

// ─── SCROLL REVEAL ────────────────────────────────────────────
const revealObs = new IntersectionObserver(
  entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('in');
        revealObs.unobserve(e.target); // fire once
      }
    });
  },
  { threshold: 0.07 }
);
document.querySelectorAll('.rv').forEach(el => revealObs.observe(el));

// ─── COUNT UP ─────────────────────────────────────────────────
function countUp(el: HTMLElement): void {
  const target = parseInt(el.dataset.target ?? '0', 10);
  const start  = performance.now();
  const duration = 1800;

  const tick = (now: number): void => {
    const progress = Math.min((now - start) / duration, 1);
    // Ease out cubic
    const ease = 1 - Math.pow(1 - progress, 3);
    el.textContent = String(Math.floor(ease * target));
    if (progress < 1) requestAnimationFrame(tick);
  };

  requestAnimationFrame(tick);
}

// Reduced motion: skip animation, show final value immediately
const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

const countObs = new IntersectionObserver(
  entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const el = e.target as HTMLElement;
        if (prefersReduced) {
          el.textContent = el.dataset.target ?? '0';
        } else {
          countUp(el);
        }
        countObs.unobserve(el);
      }
    });
  },
  { threshold: 0.5 }
);
document.querySelectorAll<HTMLElement>('.count-up').forEach(el => countObs.observe(el));
</script>
