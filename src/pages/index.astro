t marketing','Génération de leads','SEO & Visibilité','Landing pages','Copywriting','Stratégie digitale']},
  en:{'nav.services':'Services','nav.process':'Process','nav.blog':'Blog','nav.contact':'Contact','nav.cta':'Get started →','h.tag':'Evolus Agency','h.c1':'Sites delivered','h.c2':'Avg. ROI','h.c3':'Satisfaction','h.em':'your digital','h.out':'presence.','h.desc':'Custom websites, converting content, and growth strategies.','h.cta':'Start my project','h.blog':'See the blog','sv.lbl':'What we do','sv.ttl':'Three levers.<br>One goal.','sv.intro':'We engineer growth machines.','s1n':'Website creation','s1d':'Landing pages and e-commerce built to convert.','s2n':'Redesign & scaling','s2d':'We diagnose, restructure and optimize.','s3n':'Content & leads','s3d':'SEO articles and sales funnels that convert.','pr.lbl':'How it works','pr.ttl':'A clear process,<br>measurable results.','p1n':'Audit & strategy','p1d':'Market analysis.','p1w':'Week 1','p2n':'Design & UX','p2d':'High-fidelity mockups.','p2w':'Weeks 2–3','p3n':'Development','p3d':'Clean code, easy CMS.','p3w':'Weeks 3–5','p4n':'Content & SEO','p4d':'Optimized copy.','p4w':'Ongoing','p5n':'Launch & growth','p5d':'We scale together.','p5w':'Ongoing','rs.lbl':'Our numbers','rs.ttl':'Results<br>that speak.','r1l':'avg. organic traffic','r1d':'Traffic triples in 6 months.','r2l':'Avg. delivery','r2d':'Speed without compromise.','r3l':'Clients','r3d':'From startup to SME.','r4l':'Avg. ROI','r4d':'Every dollar returns three.','ts.lbl':'Trusted by','ts.ttl':'What our clients<br>say.','t1':'Evolus turned our site into a sales tool. Quotes doubled in 3 months.','t2':'Content has been generating leads for 6 months without effort.','t3':'+280% traffic in 4 months.','ct.lbl':'Let\'s take action','ct.ttl':'Your site deserves<br>better.','ct.desc':'Free audit, clear strategy, measurable results.','ct.btn':'Get in touch','ct.mail':'Or email us:','mq':['Website creation','Redesign & optimization','Content marketing','Lead generation','SEO & Visibility','Landing pages','Copywriting','Digital strategy']}
};

let lang='fr';

function applyLang(){
  const t=T[lang];
  document.querySelectorAll('[data-i18n]').forEach(el=>{
    const k=el.getAttribute('data-i18n');
    if(t[k]!==undefined) el.innerHTML=t[k];
  });
  const hl1=document.getElementById('hl1');
  if(hl1) hl1.textContent=lang==='fr'?'On crée':'We build';
  const mq=document.getElementById('mq');
  if(mq){
    const items=[...t['mq'],...t['mq']];
    mq.innerHTML=items.map(i=>`<span class="mq-item">${i}</span>`).join('');
  }
  document.getElementById('lb-fr').classList.toggle('on',lang==='fr');
  document.getElementById('lb-en').classList.toggle('on',lang==='en');
  document.documentElement.lang=lang;
}

function setLang(l){
  lang=l;
  localStorage.setItem('evolus_lang',l);
  applyLang();
}

function navTo(id){
  const el=document.getElementById(id);
  if(el) el.scrollIntoView({behavior:'smooth',block:'start'});
}

// Auto-detect
(function(){
  const saved=localStorage.getItem('evolus_lang');
  if(saved){lang=saved;}
  else{
    const bl=(navigator.language||'en').toLowerCase();
    const fr=['fr','be','ch','ca','lu','mc','sn','ci','cm','mg'];
    lang=fr.some(c=>bl.startsWith(c)||bl.includes('-'+c))?'fr':'en';
  }
  applyLang();
})();

// Cursor
const cur=document.getElementById('cur');
document.addEventListener('mousemove',e=>{cur.style.left=e.clientX+'px';cur.style.top=e.clientY+'px';});
document.querySelectorAll('a,button,.svc-card,.step,.tsti-card').forEach(el=>{
  el.addEventListener('mouseenter',()=>cur.classList.add('h'));
  el.addEventListener('mouseleave',()=>cur.classList.remove('h'));
});

// Scroll reveal
const rvObs=new IntersectionObserver(ev=>{ev.forEach(e=>{if(e.isIntersecting)e.target.classList.add('in');});},{threshold:.08});
document.querySelectorAll('.rv').forEach(el=>rvObs.observe(el));

// Count up
function countUp(el){
  const t=parseInt(el.dataset.target);
  const s=performance.now();
  const go=n=>{const p=Math.min((n-s)/1800,1);el.textContent=Math.floor((1-Math.pow(1-p,3))*t);if(p<1)requestAnimationFrame(go);};
  requestAnimationFrame(go);
}
const coObs=new IntersectionObserver(ev=>{ev.forEach(e=>{if(e.isIntersecting){countUp(e.target);coObs.unobserve(e.target);}});},{threshold:.5});
document.querySelectorAll('.count-up').forEach(el=>coObs.observe(el));
</script>
