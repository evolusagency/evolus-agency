---
import { getCollection, render } from 'astro:content';
import '../../styles/global.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => {
    const slug = post.id.replace(/\.md$/, '');
    return {
      params: { slug },
      props:  { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);
const slug = post.id.replace(/\.md$/, '');
---
<!DOCTYPE html>
<html lang="fr">
<head>
<link rel="canonical" href={`https://evolus.agency/blog/${slug}`} />

<meta property="og:type" content="article" />
<meta property="og:title" content={post.data.title} />
<meta property="og:description" content={post.data.excerpt} />
<meta property="og:image" content={post.data.image} />

<meta name="twitter:card" content="summary_large_image" />
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{post.data.title} — Evolus Agency</title>
<meta name="description" content={post.data.excerpt}>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--black:#0a0a0a;--white:#f5f2ec;--accent:#c8f03e;--accent-dark:#a8cc2e;--muted:#6b6860;--border:rgba(245,242,236,0.12);--card:#111110}
html{scroll-behavior:smooth}
body{font-family:'DM Sans',sans-serif;background:var(--black);color:var(--white);overflow-x:hidden;cursor:none}
.cur{position:fixed;width:12px;height:12px;background:var(--accent);border-radius:50%;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);transition:width .3s,height .3s;mix-blend-mode:difference}
.cur.h{width:44px;height:44px}
body::before{content:'';position:fixed;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");pointer-events:none;z-index:1000;opacity:.4}

nav{position:fixed;top:0;left:0;right:0;z-index:500;padding:1.4rem 3rem;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border);background:rgba(10,10,10,.85);backdrop-filter:blur(20px)}
.logo{font-family:'Syne',sans-serif;font-weight:800;font-size:1.35rem;color:var(--white);text-decoration:none;display:flex;align-items:center;gap:.55rem}
.logo svg{width:30px;height:30px}
.logo span{color:var(--accent)}
.nav-links{display:flex;gap:2.2rem;list-style:none}
.nav-links a{font-size:.87rem;color:var(--muted);text-decoration:none;transition:color .2s}
.nav-links a:hover,.nav-links a.active{color:var(--white)}
.nav-cta{font-family:'Syne',sans-serif;font-size:.87rem;font-weight:600;padding:.58rem 1.35rem;background:var(--accent);color:var(--black);text-decoration:none;border-radius:100px;transition:transform .2s}
.nav-cta:hover{background:var(--accent-dark);transform:scale(1.04)}

.art-reader-hero{padding:9rem 3rem 5rem;position:relative;overflow:hidden;border-bottom:1px solid var(--border)}
.art-reader-bg{position:absolute;inset:0;background:radial-gradient(ellipse 60% 50% at 60% 40%,#1a2f0a 0%,transparent 65%)}
.art-reader-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(245,242,236,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(245,242,236,.025) 1px,transparent 1px);background-size:60px 60px}
.art-reader-c{position:relative;z-index:2;max-width:820px}
.art-back{display:inline-flex;align-items:center;gap:.5rem;font-size:.82rem;color:var(--muted);text-decoration:none;margin-bottom:2.5rem;transition:color .2s}
.art-back:hover{color:var(--accent)}
.art-reader-tag{display:inline-flex;align-items:center;gap:.5rem;font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);margin-bottom:1.2rem}
.art-reader-tag::before{content:'';display:block;width:20px;height:1px;background:var(--accent)}
.art-reader-h{font-family:'Syne',sans-serif;font-size:clamp(2rem,3vw,4rem);font-weight:300;letter-spacing:-.02em;line-height:1.05;margin-bottom:1.5rem}
.art-reader-meta{display:flex;align-items:center;gap:1.5rem;font-size:.8rem;color:var(--muted)}
.art-reader-meta span{display:flex;align-items:center;gap:.4rem}

.art-reader-body{max-width:820px;margin:0 auto;padding:5rem 3rem 7rem}
/* All typography/spacing rules for the rendered markdown (p, h2, h3,
   ul, li, blockquote, hr, code, strong) now live in global.css.
   They CANNOT live in this scoped <style> block — Astro's scoped
   CSS only matches elements rendered directly by this file's own
   template, and the markdown HTML from <Content /> is rendered by
   a separate component that never gets the scope attribute, so any
   selector here would silently never match. See global.css section
   13 for the actual rules and full explanation. */

.art-cta-box{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:2.5rem;text-align:center;margin-top:4.5rem}
.art-cta-box h3{font-family:'Syne',sans-serif;font-size:1.5rem;font-weight:800;margin-bottom:.8rem;color:var(--white)}
.art-cta-box p{color:var(--muted);font-size:.95rem;margin-bottom:1.8rem;line-height:1.6}
.btn-p{font-family:'Syne',sans-serif;font-weight:700;font-size:.95rem;padding:.9rem 2rem;background:var(--accent);color:var(--black);text-decoration:none;border-radius:100px;transition:transform .25s,box-shadow .25s;display:inline-flex;align-items:center;gap:.6rem}
.btn-p:hover{transform:translateY(-2px);box-shadow:0 12px 40px rgba(200,240,62,.3)}

footer{border-top:1px solid var(--border);padding:2.2rem 3rem;display:flex;align-items:center;justify-content:space-between;background:var(--black)}
.f-copy{font-size:.73rem;color:var(--muted)}
.f-links{display:flex;gap:1.5rem;list-style:none}
.f-links a{font-size:.73rem;color:var(--muted);text-decoration:none;transition:color .2s}
.f-links a:hover{color:var(--white)}

@media(max-width:900px){
  nav{padding:1.2rem 1.5rem}
  .nav-links{display:none}
  .art-reader-hero{padding:7rem 1.5rem 3rem}
  .art-reader-body{padding:3rem 1.5rem 5rem}
  footer{flex-direction:column;gap:1rem;text-align:center;padding:2rem 1.5rem}
}
/* Link styling for article content lives in global.css (section 12) —
   for the same scoping reason as the spacing rules above: a scoped
   selector here would never match the <a> tags injected by <Content />. */
</style>
</head>
<body>
<div class="cur" id="cur"></div>

<nav>
  <a class="logo" href="/">
    <svg viewBox="0 0 680 700" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" width="30" height="30">
      <g transform="translate(340,300)" fill="#c8f03e">
        <polygon points="-195,-230 0,-310 195,-230 195,-195 0,-275 -195,-195" />
        <polygon points="-155,-215 0,-285 155,-215 155,-190 0,-260 -155,-190" fill="#ffff" />
        <polygon points="-195,-140 0,-220 195,-140 195,-105 0,-185 -195,-105" />
        <polygon points="-155,-125 0,-200 155,-125 155,-100 0,-175 -155,-100" fill="#ffff" />
        <polygon points="-195,-50 0,-130 195,-50 195,-15 0,-95 -195,-15" />
        <polygon points="-155,-35 0,-110 155,-35 155,-10 0,-85 -155,-10" fill="#ffff" />
        <polygon points="10,35 10,35 -155,270 -205,270" />
        <polygon points="10,35 10,35 205,270 155,270" />
        <rect x="-95" y="143" width="190" height="38" rx="5"/>
      </g>
    </svg>
    evolus<span>.</span>
  </a>
  <ul class="nav-links">
    <li><a href="/#services">Services</a></li>
    <li><a href="/#process">Processus</a></li>
    <li><a href="/works">Réalisations</a></li>
    <li><a href="/blog" class="active">Blog</a></li>
    <li><a href="/#contact">Contact</a></li>
  </ul>
  <a href="/#contact" class="nav-cta">Démarrer →</a>
</nav>

<div class="art-reader-hero">
  <div class="art-reader-bg"></div><div class="art-reader-grid"></div>
  <div class="art-reader-c">
    <a class="art-back" href="/blog">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Retour au blog
    </a>
    <div class="art-reader-tag">{post.data.tag}</div>
    <h1 class="art-reader-h">{post.data.title}</h1>
    <div class="art-reader-meta">
      <span>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
        {new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(post.data.date)}
      </span>
      <span>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        {post.data.read} de lecture
      </span>
    </div>
  </div>
</div>
{post.data.image && (
  <div style="max-width:820px;margin:0 auto;padding:0 3rem;">
    <img
      src={post.data.image}
      alt={post.data.title}
      loading="lazy"
      decoding="async"
      style="width:100%;border-radius:12px;margin-top:2rem;border:1px solid rgba(245,242,236,0.12);"
    />
  </div>
)}

<article class="art-reader-body">
  <Content />
  <div class="art-cta-box">
    <h3>Envie d'appliquer ces conseils ?</h3>
    <p>On réalise un audit gratuit de votre site et on vous livre un plan d'action personnalisé sous 48h.</p>
    <a href="/#contact" class="btn-p" style="color:black !important;">
      Obtenir mon audit gratuit
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg>
    </a>
  </div>
</article>

<footer>
  <div style="display:flex;align-items:center;gap:1.8rem">
    <a class="logo" href="/" style="font-size:1.1rem">
      <svg viewBox="0 0 680 700" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" width="20" height="20">
        <g transform="translate(340,300)" fill="#c8f03e">
          <polygon points="-195,-230 0,-310 195,-230 195,-195 0,-275 -195,-195" />
          <polygon points="-155,-215 0,-285 155,-215 155,-190 0,-260 -155,-190" fill="#ffff" />
          <polygon points="-195,-140 0,-220 195,-140 195,-105 0,-185 -195,-105" />
          <polygon points="-155,-125 0,-200 155,-125 155,-100 0,-175 -155,-100" fill="#ffff" />
          <polygon points="-195,-50 0,-130 195,-50 195,-15 0,-95 -195,-15" />
          <polygon points="-155,-35 0,-110 155,-35 155,-10 0,-85 -155,-10" fill="#ffff" />
          <polygon points="10,35 10,35 -155,270 -205,270" />
          <polygon points="10,35 10,35 205,270 155,270" />
          <rect x="-95" y="143" width="190" height="38" rx="5"/>
        </g>
      </svg>
      evolus<span>.</span>
    </a>
    <span class="f-copy">© 2025 Evolus Agency</span>
  </div>
  <ul class="f-links">
    <li><a href="/#services">Services</a></li>
    <li><a href="/blog">Blog</a></li>
    <li><a href="mailto:contact@evolus.agency">Contact</a></li>
  </ul>
</footer>

<script type="application/ld+json">
{JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.excerpt,
  "image": post.data.image,
  "datePublished": post.data.date,
  "url": `https://evolus.agency/blog/${slug}`,
  "author": { "@type": "Organization", "name": "Evolus Agency" },
  "publisher": {
    "@type": "Organization",
    "name": "Evolus Agency",
    "logo": { "@type": "ImageObject", "url": "https://evolus.agency/favicon.svg" }
  }
})}
</script>
<script>
const cur=document.getElementById('cur');
document.addEventListener('mousemove',e=>{cur.style.left=e.clientX+'px';cur.style.top=e.clientY+'px';});
document.querySelectorAll('a,button').forEach(el=>{
  el.addEventListener('mouseenter',()=>cur.classList.add('h'));
  el.addEventListener('mouseleave',()=>cur.classList.remove('h'));
});
</script>
</body>
</html>