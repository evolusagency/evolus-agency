---
import { getCollection } from 'astro:content';
const posts = await getCollection('blog');
const sorted = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const formatDate = (dateString) => {
  return new Intl.DateTimeFormat('fr-FR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  }).format(new Date(dateString));
};
---
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Blog — Evolus Agency</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--black:#0a0a0a;--white:#f5f2ec;--accent:#c8f03e;--accent-dark:#a8cc2e;--muted:#6b6860;--border:rgba(245,242,236,0.12);--card:#111110}
html{scroll-behavior:smooth}
body{font-family:'DM Sans',sans-serif;background:var(--black);color:var(--white);overflow-x:hidden;cursor:none}
.cur{position:fixed;width:12px;height:12px;background:var(--accent);border-radius:50%;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);transition:width .3s,height .3s;mix-blend-mode:difference}
.cur.h{width:44px;height:44px}
body::before{content:'';position:fixed;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");pointer-events:none;z-index:1000;opacity:.4}

nav{position:fixed;top:0;left:0;right:0;z-index:500;padding:1.4rem 3rem;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border);background:rgba(10,10,10,.85);backdrop-filter:blur(20px)}
.logo{font-family:'Syne',sans-serif;font-weight:800;font-size:1.35rem;letter-spacing:-.02em;color:var(--white);text-decoration:none;display:flex;align-items:center;gap:.55rem}
.logo svg{width:30px;height:30px}
.logo span{color:var(--accent)}
.nav-links{display:flex;gap:2.2rem;list-style:none}
.nav-links a{font-size:.87rem;color:var(--muted);text-decoration:none;transition:color .2s;cursor:pointer}
.nav-links a:hover,.nav-links a.active{color:var(--white)}
.nav-cta{font-family:'Syne',sans-serif;font-size:.87rem;font-weight:600;padding:.58rem 1.35rem;background:var(--accent);color:var(--black);text-decoration:none;border-radius:100px;transition:transform .2s,background .2s}
.nav-cta:hover{background:var(--accent-dark);transform:scale(1.04)}

.blog-hero{padding:9rem 3rem 4rem;position:relative;overflow:hidden;border-bottom:1px solid var(--border)}
.blog-hero-bg{position:absolute;inset:0;background:radial-gradient(ellipse 50% 60% at 80% 50%,#1a2f0a 0%,transparent 65%)}
.blog-hero-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(245,242,236,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(245,242,236,.025) 1px,transparent 1px);background-size:60px 60px}
.blog-hero-c{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:flex-end;gap:3rem}
.sec-label{font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;color:var(--accent);margin-bottom:1rem;display:flex;align-items:center;gap:.75rem}
.sec-label::before{content:'';display:block;width:20px;height:1px;background:var(--accent)}
.sec-title{font-family:'Syne',sans-serif;font-size:clamp(2.8rem,5vw,5rem);font-weight:800;letter-spacing:-.03em;line-height:1.05}
.blog-hero-r{max-width:360px}
.blog-hero-r p{font-size:1rem;color:var(--muted);line-height:1.7;font-weight:300;margin-bottom:1.5rem}
.blog-count{font-family:'Syne',sans-serif;font-size:.75rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);padding:.5rem 1rem;border:1px solid var(--border);border-radius:100px;display:inline-block}

.blog-list{padding:0 3rem 5rem}
.journal{position:relative}
.art-entry{display:grid;grid-template-columns:200px 1fr;gap:0;border-bottom:1px solid var(--border);opacity:0;transform:translateY(60px);transition:opacity .8s cubic-bezier(.16,1,.3,1),transform .8s cubic-bezier(.16,1,.3,1)}
.art-entry.visible{opacity:1;transform:translateY(0)}
.art-meta{padding:3rem 2rem 3rem 0;border-right:1px solid var(--border);display:flex;flex-direction:column;gap:.6rem;position:sticky;top:80px;align-self:start}
.art-num{font-family:'Syne',sans-serif;font-size:3.5rem;font-weight:800;color:#1c1c1b;line-height:1;transition:color .3s}
.art-entry:hover .art-num{color:var(--accent)}
.art-date{font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.art-tag-pill{display:inline-block;font-size:.68rem;letter-spacing:.08em;text-transform:uppercase;padding:.3rem .7rem;background:rgba(200,240,62,.1);color:var(--accent);border-radius:100px;width:fit-content}
.art-body{padding:3rem 0 3rem 3rem;cursor:pointer;text-decoration:none;color:inherit;display:block}
.art-title-wrap{display:flex;align-items:flex-start;justify-content:space-between;gap:2rem;margin-bottom:1.2rem}
.art-h{font-family:'Syne',sans-serif;font-size:clamp(1.4rem,2.5vw,2rem);font-weight:800;letter-spacing:-.02em;line-height:1.15;transition:color .3s;max-width:680px}
.art-entry:hover .art-h{color:var(--accent)}
.art-arrow{width:44px;height:44px;border:1px solid var(--border);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--muted);flex-shrink:0;transition:all .3s;margin-top:.3rem}
.art-entry:hover .art-arrow{border-color:var(--accent);color:var(--accent);transform:translate(3px,-3px)}
.art-excerpt{font-size:.95rem;color:var(--muted);line-height:1.75;font-weight:300;max-width:680px;margin-bottom:1.8rem}
.art-footer{display:flex;align-items:center;gap:1.5rem}
.art-read{font-size:.75rem;color:var(--muted);display:flex;align-items:center;gap:.4rem}

footer{border-top:1px solid var(--border);padding:2.2rem 3rem;display:flex;align-items:center;justify-content:space-between;background:var(--black)}
.f-copy{font-size:.73rem;color:var(--muted)}
.f-links{display:flex;gap:1.5rem;list-style:none}
.f-links a{font-size:.73rem;color:var(--muted);text-decoration:none;transition:color .2s}
.f-links a:hover{color:var(--white)}

.empty-state{padding:5rem 0;text-align:center;color:var(--muted)}

@media(max-width:900px){
  nav{padding:1.2rem 1.5rem}
  .nav-links{display:none}
  .blog-hero,.blog-list{padding-left:1.5rem;padding-right:1.5rem}
  .blog-hero-c{flex-direction:column}
  .art-entry{grid-template-columns:1fr}
  .art-meta{position:static;border-right:none;border-bottom:1px solid var(--border);padding:2rem 0 1.5rem}
  .art-body{padding:1.5rem 0}
  footer{flex-direction:column;gap:1rem;text-align:center;padding:2rem 1.5rem}
}
</style>
</head>
<body>
<div class="cur" id="cur"></div>

<nav>
  <a class="logo" href="/">
    <svg viewBox="0 0 1080 1080" fill="none" xmlns="http://www.w3.org/2000/svg">
      <g stroke="#c8f03e" stroke-width="60" stroke-linejoin="round"><polyline points="200,210 540,100 880,210"/><polyline points="200,300 540,190 880,300"/><polyline points="200,390 540,280 880,390"/><polyline points="200,480 540,370 880,480"/></g>
      <g stroke="#c8f03e" stroke-width="50" stroke-linejoin="round" fill="none"><line x1="230" y1="480" x2="230" y2="820"/><line x1="850" y1="480" x2="850" y2="820"/><line x1="230" y1="820" x2="540" y2="980"/><line x1="850" y1="820" x2="540" y2="980"/><line x1="540" y1="600" x2="540" y2="980"/><line x1="230" y1="820" x2="540" y2="700"/><line x1="850" y1="820" x2="540" y2="700"/></g>
    </svg>
    evolus<span>.</span>
  </a>
  <ul class="nav-links">
    <li><a href="/#services">Services</a></li>
    <li><a href="/#process">Process</a></li>
    <li><a href="/blog" class="active">Blog</a></li>
    <li><a href="/#contact">Contact</a></li>
  </ul>
  <a href="/#contact" class="nav-cta">Démarrer →</a>
</nav>

<div class="blog-hero">
  <div class="blog-hero-bg"></div><div class="blog-hero-grid"></div>
  <div class="blog-hero-c">
    <div>
      <div class="sec-label">Insights B2B</div>
      <h1 class="sec-title">Le Journal<br>Evolus.</h1>
    </div>
    <div class="blog-hero-r">
      <p>Stratégies, tendances et cas concrets pour faire croître votre business B2B. Publié chaque semaine par nos experts.</p>
      <span class="blog-count">{sorted.length} articles · Mis à jour 2026</span>
    </div>
  </div>
</div>

<div class="blog-list">
  <div class="journal">
    {sorted.length === 0 ? (
      <div class="empty-state">
        <p>Aucun article publié pour le moment.</p>
      </div>
    ) : (
      sorted.map((post, i) => (
        <div class="art-entry">
          <div class="art-meta">
            <div class="art-num">{String(i+1).padStart(2,'0')}</div>
            <div class="art-date">{formatDate(post.data.date)}</div>
            <div class="art-tag-pill">{post.data.tag}</div>
          </div>
          <a class="art-body" href={`/blog/${post.id}`}>
            <div class="art-title-wrap">
              <h2 class="art-h">{post.data.title}</h2>
              <div class="art-arrow">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg>
              </div>
            </div>
            <p class="art-excerpt">{post.data.excerpt}</p>
            <div class="art-footer">
              <span class="art-read">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                {post.data.read} de lecture
              </span>
            </div>
          </a>
        </div>
      ))
    )}
  </div>
</div>

<footer>
  <div style="display:flex;align-items:center;gap:1.8rem">
    <a class="logo" href="/" style="font-size:1.1rem">evolus<span>.</span></a>
    <span class="f-copy">© 2025 Evolus Agency</span>
  </div>
  <ul class="f-links">
    <li><a href="/#services">Services</a></li>
    <li><a href="/blog">Blog</a></li>
    <li><a href="mailto:contact@evolus.agency">Contact</a></li>
  </ul>
</footer>

<script>
const cur=document.getElementById('cur');
document.addEventListener('mousemove',e=>{cur.style.left=e.clientX+'px';cur.style.top=e.clientY+'px';});
document.querySelectorAll('a,button,.art-entry').forEach(el=>{
  el.addEventListener('mouseenter',()=>cur.classList.add('h'));
  el.addEventListener('mouseleave',()=>cur.classList.remove('h'));
});

const obs=new IntersectionObserver(ev=>{
  ev.forEach((e,i)=>{
    if(e.isIntersecting){
      setTimeout(()=>e.target.classList.add('visible'), i*80);
      obs.unobserve(e.target);
    }
  });
},{threshold:.08});
document.querySelectorAll('.art-entry').forEach(el=>obs.observe(el));
</script>
</body>
</html>